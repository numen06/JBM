# ===================================================
# RabbitMQ 基础连接配置
# ===================================================
spring.rabbitmq.host=10.100.10.121
spring.rabbitmq.port=5672
spring.rabbitmq.username=admin
spring.rabbitmq.password=admin
spring.rabbitmq.virtual-host=/
spring.rabbitmq.publisher-confirms=true
spring.rabbitmq.publisher-returns=true
spring.rabbitmq.template.mandatory=true

# 心跳间隔（秒）
spring.rabbitmq.requested-heartbeat=30

# 连接超时（毫秒）
spring.rabbitmq.connection-timeout=15000


# ===================================================
# 消息发送端重试配置（RabbitTemplate 发送失败重试）
# ===================================================
spring.rabbitmq.template.retry.enabled=true
spring.rabbitmq.template.retry.max-attempts=10
spring.rabbitmq.template.retry.initial-interval=1000
spring.rabbitmq.template.retry.max-interval=30000
spring.rabbitmq.template.retry.multiplier=2.0


# ===================================================
# 消费者监听器配置（自动确认模式）
# 关键：限制重试次数 + 合理超时 + 心跳检测
# ===================================================

# 使用自动确认（Spring 在方法成功返回后自动发送 ack）
spring.rabbitmq.listener.simple.acknowledge-mode=auto

# 消费者重试配置（避免无限重试导致 channel 阻塞）
spring.rabbitmq.listener.simple.retry.enabled=true
spring.rabbitmq.listener.simple.retry.max-attempts=3
spring.rabbitmq.listener.simple.retry.initial-interval=5000
spring.rabbitmq.listener.simple.retry.multiplier=2.0
spring.rabbitmq.listener.simple.retry.max-interval=30000

# 消费者处理超时时间（毫秒）
# 默认 1800000（30分钟），建议不要设为 0
# 如果业务逻辑可能超过30分钟，请拆分任务
spring.rabbitmq.listener.simple.consumer-timeout=1800000

# 心跳检测（毫秒）：检测消费者是否存活
spring.rabbitmq.listener.simple.missing-heartbeat=30000

# 并发配置
spring.rabbitmq.listener.simple.concurrency=1
spring.rabbitmq.listener.simple.max-concurrency=4
