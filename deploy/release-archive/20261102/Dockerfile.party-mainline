FROM --platform=$BUILDPLATFORM m.daocloud.io/docker.io/python:3.12-slim AS ip-data
COPY jbm-python-cluster/auth/fetch_ip_regions.py /data/fetch_ip_regions.py
RUN python /data/fetch_ip_regions.py
FROM registry.cn-shanghai.aliyuncs.com/okc/jbm-python-cluster@sha256:f61d9677006de35523b2a609aaf1f5ec66d2e762f4caf665c370350b7b6e26db AS jbm-auth
COPY --chown=appuser jbm-python-cluster/common /app/common
RUN python -c "import pathlib; [compile(p.read_bytes(), str(p), 'exec') for p in pathlib.Path('/app/common/src/jbm_cluster_py/common').rglob('*.py')]"
COPY --chown=appuser jbm-python-cluster/auth /app/auth
RUN python -c "import pathlib; [compile(p.read_bytes(), str(p), 'exec') for p in pathlib.Path('/app/auth/src/jbm_cluster_py/platform/auth').rglob('*.py')]"
USER root
RUN pip install --no-cache-dir --index-url https://mirrors.aliyun.com/pypi/simple/ py-ip2region==3.0.6
COPY --from=ip-data /data/data/ /app/auth/data/
RUN python -c "from jbm_cluster_py.platform.auth.login_security import OfflineRegions; r=OfflineRegions({}); r.start(); assert r.lookup('114.114.114.114')"
USER appuser
