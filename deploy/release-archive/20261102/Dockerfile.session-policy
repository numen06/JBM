FROM registry.cn-shanghai.aliyuncs.com/okc/jbm-python-cluster@sha256:8a46f14bcc5e59f3e1f2ad006e95fd807aa80e41ffe56fc15b463a203ba191a6 AS jbm-python-cluster
COPY --chown=appuser:appuser jbm-python-cluster/auth/src/jbm_cluster_py/platform/auth/service.py /app/auth/src/jbm_cluster_py/platform/auth/service.py
COPY --chown=appuser:appuser jbm-python-cluster/auth/src/jbm_cluster_py/platform/auth/router.py /app/auth/src/jbm_cluster_py/platform/auth/router.py
COPY --chown=appuser:appuser jbm-python-cluster/auth/resource/application.yml /app/auth/resource/application.yml

FROM --platform=$BUILDPLATFORM m.daocloud.io/docker.io/library/node:22-alpine AS admin-builder
WORKDIR /jbm
COPY jbm-admin-vue/package*.json ./
COPY jbm-admin-vue/packages ./packages
RUN npm ci
COPY jbm-admin-vue ./
RUN JBM_ADMIN_BASE_PATH=/jbm/ npm run build

FROM registry.cn-shanghai.aliyuncs.com/okc/jbm-admin@sha256:abaf641d6eb095db148e0a437d3cb2d3a9854f27d612e88b8ce9d9485a20439b AS jbm-admin
COPY --from=admin-builder /jbm/dist /usr/share/nginx/html

FROM registry.cn-shanghai.aliyuncs.com/okc/jbm-cluster-platform-center@sha256:7bbc312f022578d27eb81845e1899d07466f493af02505fa94aacb9d7c7a9203 AS jbm-cluster-platform-center
COPY jbm-python-cluster/deploy/patch_session_policy.py /tmp/patch_session_policy.py
USER root
RUN python /tmp/patch_session_policy.py
USER appuser
