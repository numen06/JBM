{
  "profile": "jaja7",
  "base_url": "http://127.0.0.1:7777",
  "auth_base_url": "http://127.0.0.1:5555",
  "id_token_path": "/internal/trust/id-token",
  "client_id": "jbm-cluster-platform-center-jbm7",
  "tenant_header": "tenantId",
  "tenant_id": "0",
  "health_path": "/actuator/health",
  "internal_service": "jbm-cluster-platform-center-jbm7",
  "internal_instance": "center:test",
  "simulate_remote_ip": "10.0.0.99",
  "username": "",
  "password": "",
  "oauth_client_id": "jbmSeedDevAppKey00000001",
  "oauth_client_secret": "jbmSeedDevSecret0000000001",
  "modules": [
    {
      "id": "test-user",
      "title": "Feign test user",
      "scenarios": [
        {
          "id": "TC-TRUST-00",
          "title": "register oauth",
          "precondition": "up",
          "steps": [
            {
              "name": "register",
              "method": "POST",
              "path": "/user/registrations",
              "auth": "none",
              "bodyType": "query",
              "body": "userName=utrust_{usuffix}&password=Test@trust_{usuffix}&confirmPassword=Test@trust_{usuffix}&nickName=TRUST_{usuffix}",
              "expect": "success",
              "extract": {
                "testUserName": "literal.utrust_{usuffix}",
                "testPassword": "literal.Test@trust_{usuffix}"
              }
            },
            {
              "name": "oauth",
              "service": "auth",
              "auth": "none",
              "method": "POST",
              "path": "/oauth2/token",
              "bodyType": "form",
              "body": "grant_type=password&client_id={oauth_client_id}&client_secret={oauth_client_secret}&username={testUserName}&password={testPassword}&scope=all",
              "expect": "success",
              "extract": {
                "accessToken": "result.access_token"
              },
              "assert": [
                "notEmpty:result.access_token"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "trust",
      "title": "Feign trust",
      "scenarios": [
        {
          "id": "TC-TRUST-01",
          "title": "client token ok",
          "steps": [
            {
              "name": "routes",
              "method": "GET",
              "path": "/gateway/api/route",
              "auth": "client_only",
              "internal_headers": true,
              "expect": "optional",
              "assert": [
                "isTrue:success"
              ]
            }
          ]
        },
        {
          "id": "TC-TRUST-02",
          "title": "no token",
          "steps": [
            {
              "name": "no auth",
              "method": "GET",
              "path": "/gateway/api/route",
              "auth": "none",
              "expect": "fail"
            }
          ]
        },
        {
          "id": "TC-TRUST-03",
          "title": "bad token",
          "steps": [
            {
              "name": "bad",
              "method": "GET",
              "path": "/gateway/api/route",
              "auth": "client_invalid",
              "internal_headers": true,
              "expect": "fail"
            }
          ]
        },
        {
          "id": "TC-TRUST-04",
          "title": "id token only invalid",
          "steps": [
            {
              "name": "id only fake",
              "method": "GET",
              "path": "/gateway/api/route",
              "auth": "id_token_only",
              "expect": "fail"
            }
          ]
        },
        {
          "id": "TC-TRUST-05",
          "title": "user token current user",
          "steps": [
            {
              "name": "current user",
              "method": "GET",
              "path": "/current/user",
              "auth": "user",
              "expect": "success",
              "assert": [
                "isTrue:success",
                "notNull:result.userId"
              ]
            }
          ]
        },
        {
          "id": "TC-TRUST-06",
          "title": "valid id token internal",
          "steps": [
            {
              "name": "routes id-token",
              "method": "GET",
              "path": "/gateway/api/route",
              "auth": "id_token_valid",
              "internal_headers": true,
              "expect": "optional",
              "assert": [
                "isTrue:success"
              ]
            }
          ]
        }
      ]
    }
  ],
  "center_base_url": "http://127.0.0.1:7777"
}
