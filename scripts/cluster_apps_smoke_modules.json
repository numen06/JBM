{
  "profile": "jaja7",
  "services": {
    "auth": { "port": 5555, "health": "/actuator/health" },
    "center": { "port": 7777, "health": "/actuator/health" },
    "gateway": { "port": 6060, "health": "/actuator/health" },
    "logs": { "port": 3312, "health": "/actuator/health" },
    "push": { "port": 3313, "health": "/actuator/health" },
    "doc": { "port": 9999, "health": "/actuator/health" },
    "job": { "port": 4444, "health": "/actuator/health" },
    "weixin": { "port": 3319, "health": "/actuator/health" },
    "bigscreen": { "port": 3314, "health": "/actuator/health" }
  },
  "cases": [
    {
      "id": "health-logs",
      "service": "logs",
      "via": "direct",
      "method": "GET",
      "path": "/actuator/health",
      "expectStatus": [200],
      "allowSkipIfDown": true
    },
    {
      "id": "gateway-logs-access",
      "service": "logs",
      "via": "gateway",
      "method": "POST",
      "path": "/clusterAccess/getClusterAccessInfo",
      "body": {},
      "expectAuth": true,
      "allowSkipIfDown": true
    },
    {
      "id": "gateway-logs-find",
      "service": "logs",
      "via": "gateway",
      "method": "POST",
      "path": "/GatewayLogs/findLogs",
      "body": { "pageForm": { "currPage": 1, "pageSize": 5 } },
      "expectAuth": true,
      "allowSkipIfDown": true
    },
    {
      "id": "gateway-push-pageList",
      "service": "push",
      "via": "gateway",
      "method": "POST",
      "path": "/pushMessage/pageList",
      "body": { "pageForm": { "currPage": 1, "pageSize": 5 } },
      "expectAuth": true,
      "allowSkipIfDown": true
    },
    {
      "id": "gateway-job-test",
      "service": "job",
      "via": "gateway",
      "method": "GET",
      "path": "/sysJob/test",
      "expectAuth": true,
      "allowSkipIfDown": true
    },
    {
      "id": "gateway-bigscreen-isUpload",
      "service": "bigscreen",
      "via": "gateway",
      "method": "POST",
      "path": "/bigscreenView/isUpload",
      "body": { "viewName": "cluster_ext_smoke" },
      "expectAuth": true,
      "allowSkipIfDown": true
    },
    {
      "id": "gateway-doc-pageList",
      "service": "doc",
      "via": "gateway",
      "method": "POST",
      "path": "/baseDoc/pageList",
      "body": { "pageForm": { "currPage": 1, "pageSize": 5 } },
      "expectAuth": true,
      "allowSkipIfDown": true
    },
    {
      "id": "auth-no-token-logs",
      "service": "logs",
      "via": "gateway",
      "method": "POST",
      "path": "/clusterAccess/getClusterAccessInfo",
      "body": {},
      "expectNoAuth": true,
      "expectStatus": [401, 403],
      "allowSkipIfDown": true
    },
    {
      "id": "auth-fake-internal-header",
      "service": "logs",
      "via": "gateway",
      "method": "POST",
      "path": "/clusterAccess/getClusterAccessInfo",
      "body": {},
      "headers": { "X-Internal-Service": "fake-service" },
      "expectNoAuth": true,
      "expectStatus": [401, 403],
      "allowSkipIfDown": true
    }
  ]
}
