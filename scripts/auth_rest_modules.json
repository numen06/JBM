  "modules": [
    {
      "id": "oauth2-smoke",
      "title": "OAuth2 smoke",
      "scenarios": [
        {
          "id": "TC-AUTH-00",
          "title": "health",
          "precondition": "",
          "steps": [
            {
              "name": "health",
              "method": "GET",
              "path": "/actuator/health",
              "body": "",
              "bodyType": "",
              "expect": "optional"
            }
          ]
        },
        {
          "id": "TC-AUTH-03",
          "title": "client_credentials",
          "precondition": "",
          "steps": [
            {
              "name": "client token",
              "method": "POST",
              "path": "/oauth2/token",
              "body": "grant_type=client_credentials&client_id={client_id}&client_secret={client_secret}&scope=all",
              "bodyType": "form",
              "expect": "optional",
              "extract": {
                "accessToken": "result.access_token"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "test-user",
      "title": "专用测试用户",
      "scenarios": [
        {
          "id": "TC-AUTH-01",
          "title": "注册并 OAuth 登录",
          "precondition": "Gateway+Auth 可用；无同名 uauth_{usuffix}",
          "steps": [
            {
              "name": "register",
              "service": "gateway",
              "method": "POST",
              "path": "/user/registrations",
              "bodyType": "query",
              "body": "userName=uauth_{usuffix}&password=Test@auth_{usuffix}&confirmPassword=Test@auth_{usuffix}&nickName=AUTH_{usuffix}",
              "expect": "success",
              "extract": {
                "testUserName": "literal.uauth_{usuffix}",
                "testPassword": "literal.Test@auth_{usuffix}"
              }
            },
            {
              "name": "resolve userId",
              "service": "gateway",
              "method": "GET",
              "path": "/user",
              "bodyType": "query",
              "body": "userName={testUserName}",
              "expect": "success",
              "extract": {
                "userId": "result.0.userId"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "oauth2-core",
      "title": "OAuth2 core",
      "scenarios": [
        {
          "id": "TC-AUTH-02",
          "title": "password grant",
          "precondition": "TC-AUTH-01 已注册",
          "steps": [
            {
              "name": "password token",
              "method": "POST",
              "path": "/oauth2/token",
              "body": "grant_type=password&client_id={client_id}&client_secret={client_secret}&username={testUserName}&password={testPassword}&scope=all",
              "bodyType": "form",
              "expect": "success",
              "extract": {
                "accessToken": "result.access_token",
                "refreshToken": "result.refresh_token"
              },
              "assert": [
                "notEmpty:result.access_token"
              ]
            }
          ]
        },
        {
          "id": "TC-AUTH-05",
          "title": "userinfo",
          "precondition": "TC-AUTH-01 已登录",
          "steps": [
            {
              "name": "userinfo",
              "method": "GET",
              "path": "/oauth2/userinfo",
              "body": "access_token={accessToken}",
              "bodyType": "query",
              "expect": "success",
              "assert": [
                "notNull:result.userId",
                "isList:result.roles",
                "isList:result.menuPermission"
              ]
            }
          ]
        },
        {
          "id": "TC-AUTH-04",
          "title": "refresh",
          "precondition": "TC-AUTH-01 已登录",
          "steps": [
            {
              "name": "refresh",
              "method": "POST",
              "path": "/oauth2/refresh",
              "body": "grant_type=refresh_token&client_id={client_id}&client_secret={client_secret}&refresh_token={refreshToken}",
              "bodyType": "form",
              "expect": "optional",
              "extract": {
                "accessToken": "result.access_token"
              }
            }
          ]
        },
        {
          "id": "TC-AUTH-12",
          "title": "renewal",
          "precondition": "TC-AUTH-01 已登录",
          "steps": [
            {
              "name": "renewal",
              "method": "POST",
              "path": "/oauth2/renewal",
              "body": "access_token={accessToken}",
              "bodyType": "form",
              "expect": "success"
            }
          ]
        },
        {
          "id": "TC-AUTH-13",
          "title": "diagnose",
          "precondition": "TC-AUTH-01 已登录",
          "steps": [
            {
              "name": "diagnose",
              "method": "GET",
              "path": "/token/diagnose/check",
              "body": "tokenValue={accessToken}",
              "bodyType": "query",
              "expect": "success",
              "assert": [
                "contains:result.诊断结论:双层Token均有效",
                "ttlMaxDelta:result.1_Sa-Token层.token_TTL(秒):result.2_OAuth2层.access_token_TTL(秒):120"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "satoken-align",
      "title": "Sa-Token OAuth2 align",
      "scenarios": [
        {
          "id": "TC-AUTH-14",
          "title": "config unified",
          "precondition": "Auth 已启动",
          "steps": [
            {
              "name": "diagnose config",
              "method": "GET",
              "path": "/token/diagnose/config",
              "body": "",
              "bodyType": "",
              "expect": "optional",
              "assert": []
            }
          ]
        },
        {
          "id": "TC-AUTH-15",
          "title": "renewal then ttl aligned",
          "precondition": "TC-AUTH-01 已登录",
          "steps": [
            {
              "name": "password token",
              "method": "POST",
              "path": "/oauth2/token",
              "body": "grant_type=password&client_id={client_id}&client_secret={client_secret}&username={testUserName}&password={testPassword}&scope=all",
              "bodyType": "form",
              "expect": "success",
              "extract": {
                "accessToken": "result.access_token"
              }
            },
            {
              "name": "renewal",
              "method": "POST",
              "path": "/oauth2/renewal",
              "body": "access_token={accessToken}",
              "bodyType": "form",
              "expect": "success"
            },
            {
              "name": "diagnose after renewal",
              "method": "GET",
              "path": "/token/diagnose/check",
              "body": "tokenValue={accessToken}",
              "bodyType": "query",
              "expect": "success",
              "assert": [
                "contains:result.诊断结论:双层Token均有效",
                "ttlMaxDelta:result.1_Sa-Token层.token_TTL(秒):result.2_OAuth2层.access_token_TTL(秒):120"
              ]
            }
          ]
        }
      ]
    },
