# jaja7 本地：明文密码 + 与当前库一致的 OAuth 客户端（demo 已验证可登录）
VITE_LOGIN_PLAINTEXT=true
VITE_OAUTH_CLIENT_ID=demo
VITE_OAUTH_CLIENT_SECRET=demo123
VITE_LOGIN_PASSWORD=Admin@123
VITE_LOCAL_DEV_LOGIN=true
VITE_LOCAL_DEV_PASSWORD=Admin@123

# 本地一键登录账号，格式：显示名|角色|用户名|密码|Client ID|Client Secret|说明；多个账号用英文分号分隔
# VITE_LOCAL_DEV_USERS=管理员|super_admin|admin|Admin@123|demo|demo123|全量管理权限;运营人员|operator|demo|Admin@123|demo|demo123|字典与登录日志;业务编辑|editor|viewer|Admin@123|demo|demo123|用户查看与编辑

# 恢复 JBM 种子应用后改为：
# VITE_OAUTH_CLIENT_ID=jbmSeedDevAppKey00000001
# VITE_OAUTH_CLIENT_SECRET=jbmSeedDevSecret0000000001
# VITE_LOGIN_PASSWORD=admin
