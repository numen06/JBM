{
  "name": "jbm-admin-host",
  "private": true,
  "version": "7.3.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && npm run build:app",
    "build:app": "vue-tsc -b && vite build",
    "build:packages": "npm run build -w @jbm7/sdk && npm run build -w @jbm7/vue-core && npm run build -w @jbm7/admin",
    "test": "npm run test -w @jbm7/sdk && npm run test -w @jbm7/vue-core",
    "pack:check": "npm run pack:check --workspaces --if-present",
    "demo:build": "npm run build --prefix examples/downstream-demo",
    "demo:dev": "npm run dev --prefix examples/downstream-demo",
    "preview": "vite preview"
  },
  "dependencies": {
    "@jbm7/admin": "7.3.0-beta.5",
    "@jbm7/sdk": "7.3.0-beta.5",
    "@jbm7/vue-core": "7.3.0-beta.5",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lucide/vue": "^1.16.0",
    "@stomp/stompjs": "^7.2.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "jsencrypt": "^3.5.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
