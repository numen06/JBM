{
  "name": "@jbm7/vue-core",
  "version": "7.3.0-beta.1",
  "description": "Vue 3 integration and module runtime for the JBM 7.3 technical platform",
  "type": "module",
  "files": ["dist/*.js", "dist/*.d.ts", "style.css", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@jbm7/sdk": "~7.3.0-beta.1",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@jbm7/sdk": "7.3.0-beta.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://packages.aliyun.com/604f9b79f11bae7ca07da657/npm/npm-registry/"
  },
  "license": "Apache-2.0"
}
