<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbm</groupId>
        <artifactId>jbm-examples</artifactId>
        <version>7.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>jbm-examples-extendfield-designer</artifactId>
    <name>jbm-examples-extendfield-designer</name>
    <description>扩展字段「配置侧」示例：表单定义入库 + 发布 Redis（默认端口 18081）。</description>

    <dependencies>
        <dependency>
            <groupId>com.jbm</groupId>
            <artifactId>jbm-framework-micro-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jbm</groupId>
            <artifactId>jbm-framework-autoconfigure-extendfield</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jbm</groupId>
            <artifactId>jbm-framework-autoconfigure-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>com.jbm.examples.extendfield.designer.ExtendFieldDesignerApplication</mainClass>
                    <!-- 保留瘦 jar 供联动测试 classpath 加载设计器 Main -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
