<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jbm</groupId>
        <artifactId>jbm-framework-dependencies</artifactId>
        <version>7.3.0-SNAPSHOT</version>
        <relativePath>../jbm-framework-dependencies/pom.xml</relativePath>
    </parent>
    <artifactId>jbm-examples</artifactId>
    <packaging>pom</packaging>
    <name>jbm-examples</name>
    <description>与 jbm-util 同级的框架用法「例子集合」：可运行/可测的演示与集成验证（Liquibase、MyBatis-Plus、H2 等）。</description>

    <modules>
        <module>jbm-examples-mysql</module>
        <module>jbm-examples-extendfield-designer</module>
        <module>jbm-examples-extendfield-business</module>
    </modules>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.main.skip>true</maven.main.skip>
        <maven.test.skip>true</maven.test.skip>
        <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
    </properties>

    <build>
        <plugins>
            <!-- maven deploy 忽略发布（示例模块不入远程仓库） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven-deploy-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>build-examples</id>
            <properties>
                <maven.main.skip>false</maven.main.skip>
                <maven.test.skip>false</maven.test.skip>
                <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
            </properties>
        </profile>
    </profiles>
</project>
