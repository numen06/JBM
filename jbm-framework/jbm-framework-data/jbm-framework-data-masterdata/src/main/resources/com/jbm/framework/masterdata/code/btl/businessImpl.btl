package ${codePackage};

import ${extClass};
import org.springframework.stereotype.Service;
import org.springframework.beans.factory.annotation.Autowired;
import ${businessPackage}.${businessName}Business;
    <%
    for(entity in bussinessEntityList){
    var name = entity.simpleName +"Service";
    %>
import ${servicePackage}.${name};
    <%}%>

/**
 * ${entityDesc}业务实现类
 * @Author: jbm
 * @Create: ${time}
 */
@Service
public class ${fileName} extends ${extClassName} implements ${businessName}Business {

    <%
    for(entity in bussinessEntityList){
    var name = entity.simpleName +"Service";
    var nameFeild = @cn.hutool.core.util.StrUtil.lowerFirst(entity.simpleName +"Service");
    %>
    @Autowired
    private ${name} ${nameFeild};
    <%}%>
}
