ARG PYTHON_RUNTIME=m.daocloud.io/docker.io/python:3.12
ARG NODE_BUILD_IMAGE=node:22-alpine
ARG NGINX_RUNTIME_IMAGE=registry.cn-shanghai.aliyuncs.com/numen/nginx:1.30.4-alpine

FROM ${PYTHON_RUNTIME} AS jbm-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com \
    JBM_APP=center \
    JBM_PROFILE=dev \
    PYTHONPATH=/app/common/src:/app/integrations/src:/app/auth/src:/app/doc/src:/app/push/src:/app/job/src:/app/gateway/src:/app/center/src:/app/logs/src:/app/bigscreen/src

WORKDIR /app

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/nacos-data/snapshot /app/nacos-data/failover /app/data \
    && chown -R appuser:appuser /app/nacos-data /app/data

COPY jbm-python-cluster/pyproject.toml jbm-python-cluster/requirements.txt jbm-python-cluster/README.md ./
RUN pip install -r requirements.txt

COPY --chown=appuser:appuser jbm-python-cluster/common ./common
COPY --chown=appuser:appuser jbm-python-cluster/integrations ./integrations
COPY --chown=appuser:appuser jbm-python-cluster/auth ./auth
COPY --chown=appuser:appuser jbm-python-cluster/doc ./doc
COPY --chown=appuser:appuser jbm-python-cluster/push ./push
COPY --chown=appuser:appuser jbm-python-cluster/job ./job
COPY --chown=appuser:appuser jbm-python-cluster/gateway ./gateway
COPY --chown=appuser:appuser jbm-python-cluster/center ./center
COPY --chown=appuser:appuser jbm-python-cluster/logs ./logs
COPY --chown=appuser:appuser jbm-python-cluster/bigscreen ./bigscreen

USER appuser
EXPOSE 3312 3313 3314 4444 5555 6060 7777 9999
CMD ["sh", "-c", "python -m jbm_cluster_py.platform.${JBM_APP}.main"]

FROM jbm-runtime AS jbm-python-cluster
FROM jbm-runtime AS jbm-cluster-platform-center
FROM jbm-runtime AS jbm-cluster-platform-auth
FROM jbm-runtime AS jbm-cluster-platform-gateway
FROM jbm-runtime AS jbm-cluster-platform-doc
FROM jbm-runtime AS jbm-cluster-platform-push
FROM jbm-runtime AS jbm-cluster-platform-job
FROM jbm-runtime AS jbm-cluster-platform-logs
FROM jbm-runtime AS jbm-cluster-platform-bigscreen

FROM ${NODE_BUILD_IMAGE} AS jbm-admin-builder
WORKDIR /jbm
COPY jbm-admin-vue/package*.json ./
COPY jbm-admin-vue/packages ./packages
RUN npm ci
COPY jbm-admin-vue ./
RUN npm run build \
    && mkdir -p /packs \
    && npm pack -w @jbm7/sdk --pack-destination /packs \
    && npm pack -w @jbm7/vue-core --pack-destination /packs \
    && npm pack -w @jbm7/admin --pack-destination /packs

FROM ${NGINX_RUNTIME_IMAGE} AS jbm-admin-packages
COPY --from=jbm-admin-builder /packs /packs

FROM ${NGINX_RUNTIME_IMAGE} AS jbm-admin
COPY jbm-admin-vue/nginx.docker.conf /etc/nginx/conf.d/default.conf
COPY jbm-admin-vue/docker-entrypoint.d/40-jbm-runtime-config.sh /docker-entrypoint.d/40-jbm-runtime-config.sh
COPY --from=jbm-admin-builder /jbm/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-jbm-runtime-config.sh
