<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jbm.cluster.logs.mapper.BusinessLogMapper">

    <!-- 查询条件SQL片段 -->
    <sql id="WHERE_SQL">
        <if test="logId != null">
            AND log_id = '${logId}'
        </if>
        <if test="module != null">
            AND module = '${module}'
        </if>
        <if test="operation != null">
            AND operation = '${operation}'
        </if>
        <if test="userId != null">
            AND user_id = '${userId}'
        </if>
        <if test="username != null">
            AND username like '%${username}%'
        </if>
        <if test="level != null">
            AND level = '${level}'
        </if>
        <if test="traceId != null">
            AND trace_id = '${traceId}'
        </if>
        <if test="status != null">
            AND status = '${status}'
        </if>
        <if test="keyword != null">
            AND (content like '%${keyword}%' OR biz_data like '%${keyword}%')
        </if>
        <if test="beginTime != null">
            AND create_time &gt;= '${beginTime}'
        </if>
        <if test="endTime != null">
            AND create_time &lt;= '${endTime}'
        </if>
    </sql>

    <!-- 查询业务日志列表 -->
    <!-- 注意：由于日志根据过期时间存储在不同的流中，需要查询所有可能的流 -->
    <!-- 在每个UNION部分都应用WHERE条件 -->
    <select id="selectLogs" resultType="com.jbm.cluster.logs.entity.BusinessLog">
        SELECT * FROM business_log_7d
        <where>
            <include refid="WHERE_SQL"/>
        </where>
        UNION ALL
        SELECT * FROM business_log_30d
        <where>
            <include refid="WHERE_SQL"/>
        </where>
        UNION ALL
        SELECT * FROM business_log_90d
        <where>
            <include refid="WHERE_SQL"/>
        </where>
        UNION ALL
        SELECT * FROM business_log
        <where>
            <include refid="WHERE_SQL"/>
        </where>
        ORDER BY update_time DESC
    </select>

    <!-- 根据logId查询业务日志 -->
    <!-- 注意：由于日志根据过期时间存储在不同的流中（business_log_7d, business_log_30d等），
         需要查询所有可能的流。OpenObserve可能不支持UNION，所以先尝试查询最常用的流 -->
    <!-- 如果查询不到，程序会尝试查询其他流 -->
    <select id="selectByLogId" resultType="com.jbm.cluster.logs.entity.BusinessLog">
        SELECT * FROM business_log_30d WHERE log_id = '${logId}'
        UNION ALL
        SELECT * FROM business_log_7d WHERE log_id = '${logId}'
        UNION ALL
        SELECT * FROM business_log_90d WHERE log_id = '${logId}'
        UNION ALL
        SELECT * FROM business_log WHERE log_id = '${logId}'
        ORDER BY update_time ASC
    </select>

    <!-- 查询过期的业务日志 -->
    <select id="selectExpiredLogs" resultType="com.jbm.cluster.logs.entity.BusinessLog">
        SELECT * FROM business_log
        WHERE status = 'ACTIVE'
        AND expire_date &lt; now()
        ORDER BY expire_date ASC
    </select>

    <!-- 根据模块和时间范围统计日志数量 -->
    <select id="countByModule" resultType="java.lang.Long">
        SELECT COUNT(*) FROM business_log
        WHERE module = '${module}'
        <if test="beginTime != null">
            AND create_time &gt;= '${beginTime}'
        </if>
        <if test="endTime != null">
            AND create_time &lt;= '${endTime}'
        </if>
    </select>

</mapper>

