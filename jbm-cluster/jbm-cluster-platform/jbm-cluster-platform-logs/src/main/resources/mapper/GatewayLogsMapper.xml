<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jbm.cluster.logs.mapper.GatewayLogsMapper">

    <select id="selectLogs" resultType="com.jbm.cluster.logs.entity.GatewayLogs">
        SELECT * FROM test
        <where>
            <if test="appId != null">
                AND app_id = ${appId}
            </if>
        </where>
    </select>

</mapper>